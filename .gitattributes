# Auto detect text files and perform LF normalization
* text=auto

# Source code & configs
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.md text eol=lf
*.toml text eol=lf

# Gradle wrapper script (MUST be LF for Unix/Linux/macOS CI)
/gradlew text eol=lf
/gradlew.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.so binary
